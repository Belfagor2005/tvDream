msgid "Back"
msgstr "पीछे"

msgid "Congrats! You already have the latest version..."
msgstr "बधाई! आपके पास पहले से ही नवीनतम संस्करण है..."

msgid "Do you want to install update ( %s ) now?"
msgstr "क्या आप अभी अपडेट ( %s ) इंस्टॉल करना चाहते हैं?"

msgid "Exit"
msgstr "बाहर निकलना"

msgid "Getting the list, please wait ..."
msgstr "सूची मिल रही है, कृपया प्रतीक्षा करें..."

msgid "Nothing ... Retry"
msgstr "कुछ नहीं... पुनः प्रयास करें"

msgid "Play"
msgstr "खेल"

msgid "Please select ..."
msgstr "कृपया चयन कीजिए ..."

msgid "Select"
msgstr "चुनना"

msgid "Sorry no found!"
msgstr "क्षमा करें, कोई नहीं मिला!"

msgid "Sorry no found!!!"
msgstr "क्षमा करें, कोई नहीं मिला!!!"

msgid "TVD Regions"
msgstr "टीवीडी क्षेत्र"

msgid "TVD State"
msgstr "टीवीडी राज्य"

msgid "Update"
msgstr "अद्यतन"

msgid "Update Aborted!"
msgstr "अद्यतन निरस्त किया गया!"
