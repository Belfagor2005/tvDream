msgid "Back"
msgstr "Air ais"

msgid "Congrats! You already have the latest version..."
msgstr "Mealaibh ur naidheachd! Tha an tionndadh as ùire agad mu thràth ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "A bheil thu airson ùrachadh ( %s ) a stàladh an-dràsta?"

msgid "Exit"
msgstr "Ar-a-mach"

msgid "Getting the list, please wait ..."
msgstr "A’ faighinn an liosta, fuirich thusa…"

msgid "Nothing ... Retry"
msgstr "Chan eil dad ... Feuch a-rithist"

msgid "Play"
msgstr "Seinn"

msgid "Please select ..."
msgstr "Feuch an tagh thu ..."

msgid "Select"
msgstr "Tagh"

msgid "Sorry no found!"
msgstr "Duilich cha deach a lorg!"

msgid "Sorry no found!!!"
msgstr "Duilich cha deach a lorg !!!"

msgid "TVD Regions"
msgstr "Roinnean TVD"

msgid "TVD State"
msgstr "Stàite TVD"

msgid "Update"
msgstr "Ùraich"

msgid "Update Aborted!"
msgstr "Ùrachadh air a sguireadh!"
