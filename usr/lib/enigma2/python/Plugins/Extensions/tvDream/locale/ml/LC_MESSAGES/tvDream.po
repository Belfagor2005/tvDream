msgid "Back"
msgstr "തിരികെ"

msgid "Congrats! You already have the latest version..."
msgstr "അഭിനന്ദനങ്ങൾ! നിങ്ങൾക്ക് ഇതിനകം ഏറ്റവും പുതിയ പതിപ്പുണ്ട്..."

msgid "Do you want to install update ( %s ) now?"
msgstr "നിങ്ങൾക്ക് ഇപ്പോൾ അപ്ഡേറ്റ് (%s ) ഇൻസ്റ്റാൾ ചെയ്യണോ?"

msgid "Exit"
msgstr "പുറത്ത്"

msgid "Getting the list, please wait ..."
msgstr "ലിസ്റ്റ് ലഭിക്കുന്നു, ദയവായി കാത്തിരിക്കൂ..."

msgid "Nothing ... Retry"
msgstr "ഒന്നുമില്ല... വീണ്ടും ശ്രമിക്കുക"

msgid "Play"
msgstr "കളിക്കുക"

msgid "Please select ..."
msgstr "ദയവായി തിരഞ്ഞെടുക്കുക..."

msgid "Select"
msgstr "തിരഞ്ഞെടുക്കുക"

msgid "Sorry no found!"
msgstr "ക്ഷമിക്കണം, കണ്ടെത്തിയില്ല!"

msgid "Sorry no found!!!"
msgstr "സോറി കണ്ടെത്തിയില്ല!!!"

msgid "TVD Regions"
msgstr "TVD മേഖലകൾ"

msgid "TVD State"
msgstr "TVD സ്റ്റേറ്റ്"

msgid "Update"
msgstr "അപ്ഡേറ്റ്"

msgid "Update Aborted!"
msgstr "അപ്‌ഡേറ്റ് നിർത്തലാക്കി!"
