msgid "Back"
msgstr "ಹಿಂದೆ"

msgid "Congrats! You already have the latest version..."
msgstr "ಅಭಿನಂದನೆಗಳು! ನೀವು ಈಗಾಗಲೇ ಇತ್ತೀಚಿನ ಆವೃತ್ತಿಯನ್ನು ಹೊಂದಿರುವಿರಿ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "ನೀವು ಈಗ ನವೀಕರಣವನ್ನು (%s ) ಸ್ಥಾಪಿಸಲು ಬಯಸುವಿರಾ?"

msgid "Exit"
msgstr "ನಿರ್ಗಮಿಸಿ"

msgid "Getting the list, please wait ..."
msgstr "ಪಟ್ಟಿಯನ್ನು ಪಡೆಯಲಾಗುತ್ತಿದೆ, ದಯವಿಟ್ಟು ನಿರೀಕ್ಷಿಸಿ..."

msgid "Nothing ... Retry"
msgstr "ಏನೂ ಇಲ್ಲ... ಮರುಪ್ರಯತ್ನಿಸಿ"

msgid "Play"
msgstr "ಪ್ಲೇ ಮಾಡಿ"

msgid "Please select ..."
msgstr "ದಯವಿಟ್ಟು ಆಯ್ಕೆಮಾಡಿ..."

msgid "Select"
msgstr "ಆಯ್ಕೆ ಮಾಡಿ"

msgid "Sorry no found!"
msgstr "ಕ್ಷಮಿಸಿ ಕಂಡುಬಂದಿಲ್ಲ!"

msgid "Sorry no found!!!"
msgstr "ಕ್ಷಮಿಸಿ ಯಾವುದೇ ಕಂಡುಬಂದಿಲ್ಲ !!!"

msgid "TVD Regions"
msgstr "TVD ಪ್ರದೇಶಗಳು"

msgid "TVD State"
msgstr "ಟಿವಿಡಿ ರಾಜ್ಯ"

msgid "Update"
msgstr "ನವೀಕರಿಸಿ"

msgid "Update Aborted!"
msgstr "ನವೀಕರಣವನ್ನು ಸ್ಥಗಿತಗೊಳಿಸಲಾಗಿದೆ!"
