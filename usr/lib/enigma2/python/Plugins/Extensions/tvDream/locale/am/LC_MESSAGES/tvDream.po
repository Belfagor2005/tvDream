msgid "Back"
msgstr "ተመለስ"

msgid "Congrats! You already have the latest version..."
msgstr "እንኳን ደስ ያለህ! ቀድሞውንም የቅርብ ጊዜ ስሪት አለህ..."

msgid "Do you want to install update ( %s ) now?"
msgstr "ማሻሻያ (%s) አሁን መጫን ይፈልጋሉ?"

msgid "Exit"
msgstr "ውጣ"

msgid "Getting the list, please wait ..."
msgstr "ዝርዝሩን በማግኘት ላይ፣ እባክዎ ይጠብቁ..."

msgid "Nothing ... Retry"
msgstr "ምንም... እንደገና ይሞክሩ"

msgid "Play"
msgstr "ይጫወቱ"

msgid "Please select ..."
msgstr "እባክህ ምረጥ..."

msgid "Select"
msgstr "ይምረጡ"

msgid "Sorry no found!"
msgstr "ይቅርታ አልተገኘም!"

msgid "Sorry no found!!!"
msgstr "ይቅርታ አልተገኘም!!!"

msgid "TVD Regions"
msgstr "TVD ክልሎች"

msgid "TVD State"
msgstr "TVD ግዛት"

msgid "Update"
msgstr "አዘምን"

msgid "Update Aborted!"
msgstr "ዝማኔ ተቋርጧል!"
