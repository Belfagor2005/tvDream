msgid "Back"
msgstr "ត្រឡប់មកវិញ"

msgid "Congrats! You already have the latest version..."
msgstr "អបអរសាទរ! អ្នកមានកំណែចុងក្រោយបង្អស់..."

msgid "Do you want to install update ( %s ) now?"
msgstr "តើអ្នកចង់ដំឡើងអាប់ដេត (%s) ឥឡូវនេះទេ?"

msgid "Exit"
msgstr "ចេញ"

msgid "Getting the list, please wait ..."
msgstr "ទទួលបានបញ្ជី សូមរង់ចាំ..."

msgid "Nothing ... Retry"
msgstr "គ្មានអ្វីទេ... ព្យាយាមម្តងទៀត"

msgid "Play"
msgstr "លេង"

msgid "Please select ..."
msgstr "សូមជ្រើសរើស..."

msgid "Select"
msgstr "ជ្រើសរើស"

msgid "Sorry no found!"
msgstr "សុំទោសរកមិនឃើញ!"

msgid "Sorry no found!!!"
msgstr "សុំទោសរកមិនឃើញ!!!"

msgid "TVD Regions"
msgstr "តំបន់ TVD"

msgid "TVD State"
msgstr "រដ្ឋ TVD"

msgid "Update"
msgstr "ធ្វើបច្ចុប្បន្នភាព"

msgid "Update Aborted!"
msgstr "ការអាប់ដេតត្រូវបានលុបចោល!"
